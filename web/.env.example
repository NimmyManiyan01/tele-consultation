# ==============================================================================
# Kaizentrix Enterprise Teleconsultation Platform — Frontend Environment Configuration
# Copy this template to .env.local for local development: cp .env.example .env.local
# ==============================================================================

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# LiveKit WebRTC Cloud / Self-Hosted URL
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.kaizentrix.local

# Razorpay Checkout Public Key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_kaizentrix_mock

# Application Environment Mode
NEXT_PUBLIC_APP_ENV=development

