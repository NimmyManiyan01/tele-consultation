# ==============================================================================
# Kaizentrix Enterprise Teleconsultation Platform — Backend Environment Configuration
# Copy this template to .env for local development: cp .env.example .env
# ==============================================================================

# Core Application Settings
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://telehealth.kaizentrix.com"]

# Database Connection (Async SQLAlchemy)
# For local development with SQLite:
DATABASE_URL=sqlite+aiosqlite:///./kaizentrix.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kaizentrix_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Distributed Mutex & Redis (Redlock Concurrency Engine)
REDIS_URL=redis://localhost:6379/0
REDIS_MOCK_FALLBACK=true

# Security & Cryptography (JWT & MFA)
SECRET_KEY=change_me_in_production_f7a29e1c4b8d29a0ef817c9135be
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
TOTP_ISSUER=Kaizentrix Health

# Clinical Safety & MoHFW Constraints
SCHEDULE_X_ENFORCEMENT=true
EMERGENCY_INTERCEPT_ACTIVE=true
STATUTORY_RETENTION_YEARS=3

# LiveKit WebRTC Video Engine
LIVEKIT_URL=https://livekit.kaizentrix.local
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_mock_livekit_signature

# Razorpay Payment Gateway (Test Credentials)
RAZORPAY_KEY_ID=rzp_test_kaizentrix_mock
RAZORPAY_KEY_SECRET=rzp_secret_kaizentrix_mock

# SMS / WhatsApp Notification Gateway (DLT Compliant)
GUPSHUP_API_KEY=mock_gupshup_api_key
GUPSHUP_APP_NAME=KaizentrixTelehealth

# Ayushman Bharat Digital Mission (ABDM Gateway Sandbox)
ABDM_CLIENT_ID=mock_abdm_client_id
ABDM_CLIENT_SECRET=mock_abdm_client_secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway

